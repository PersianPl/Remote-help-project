# Normalise line endings: PHP/bash stay LF in the repo, Windows keeps CRLF in the working tree
* text=auto
*.php text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.js  text eol=lf
*.mjs text eol=lf

# Binary-ish artefacts must not be line-ending converted
*.png binary
*.jpg binary
*.ico binary
*.sqlite binary

# Keep diffs readable for generated/vendored trees
node_modules/ -diff -text
server/storage/ -diff -text
